{
  "manifest_version": 3,
  "name": "Multi Tool Hub",
  "version": "2.0.0",
  "description": "Tập hợp tiện ích: Đánh giá DTU nhanh, Tải tài liệu Studocu không watermark...",
  "permissions": [
    "activeTab",

    "scripting",
    "cookies",
    "downloads",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://mydtu.duytan.edu.vn/*",
    "*://*.studocu.com/*",
    "*://*.studocu.vn/*",
    "*://*.scribd.com/*",
    "*://*.scribd.vn/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mydtu.duytan.edu.vn/sites/index.aspx?p=home_ratingform*"
      ],
      "js": [
        "src/features/dtu-univer/dtu-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studocu.vn/*"
      ],
      "js": [
        "src/features/document-download/studocu/studocu-content.js"
      ],
      "css": [
        "styles/custom-styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.scribd.com/*",
        "*://*.scribd.vn/*"
      ],
      "js": [
        "src/features/document-download/scribd/scribd-content.js"
      ],
      "css": [
        "styles/custom-styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/viewer-styles.css",
        "styles/custom-styles.css",
        "libs/html2canvas/html2canvas.min.js",
        "libs/jsPDF/jspdf.umd.min.js",
        "src/features/text-tools/text-tools.html",
        "src/features/text-tools/cleaner/cleaner.html",
        "src/features/text-tools/cleaner/cleaner.js",
        "src/features/text-tools/comparator/comparator.html",
        "src/features/text-tools/comparator/comparator.js",
        "src/features/dtu-univer/dtu-univer.html",
        "src/features/dtu-univer/skills/rating/rating.html",
        "src/features/qrcode/qrcode.html",
        "src/features/document-download/document-download.html",
        "src/features/document-download/studocu/studocu.html",
        "src/features/document-download/scribd/scribd.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}